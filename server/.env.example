NODE_ENV=development
PORT=4000

# PostgreSQL (core entities, everything transactional)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hostel
# Set to true on Render/Railway managed Postgres
DATABASE_SSL=false

# MongoDB (audit logs + notifications). Leave empty to run without them.
MONGO_URI=mongodb://localhost:27017/hostel_logs

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string_32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Comma-separated list of allowed browser origins (your deployed React client)
CORS_ORIGINS=http://localhost:5173
# Login/refresh attempts per IP per 15 minutes (keep 20 in production)
AUTH_RATE_LIMIT=20

UPLOAD_DIR=uploads
LOG_LEVEL=info
ENABLE_CRON=true
