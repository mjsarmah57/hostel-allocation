{
  "info": {
    "name": "Hostel Room Allocation API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run \"Login as …\" first; every other request uses {{accessToken}}. Set {{baseUrl}} to your deployed API for the live demo."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "roundId",
      "value": "5"
    },
    {
      "key": "hostelId",
      "value": "2"
